{
  "servers": {
    "community-filesystem": {
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/tmp/judikt-sandbox"
      ]
    },
    "authenticated-example": {
      "command": ["python3", "/opt/company-mcp/server.py"],
      "tool_name_prefix": "company.",
      "timeouts": {
        "initialize": 30,
        "list": 30,
        "call": 120
      },
      "env": {
        "UPSTREAM_API_TOKEN": {
          "from_aws_secret": "judikt/upstreams/company",
          "json_key": "api_token"
        }
      }
    },
    "vault-authenticated-example": {
      "command": ["python3", "/opt/company-mcp/server.py"],
      "env": {
        "UPSTREAM_API_TOKEN": {
          "from_vault": "secret/data/judikt/company",
          "json_key": "api_token"
        }
      }
    },
    "remote-streamable-http-example": {
      "url": "https://mcp.example.com/mcp",
      "headers": {
        "Authorization": {
          "from_env": "COMPANY_MCP_AUTHORIZATION"
        }
      },
      "timeouts": {
        "initialize": 15,
        "list": 15,
        "call": 60
      },
      "allow_private_network": false
    }
  }
}

{
  "local_stdio_identity": "local-operator",
  "identity_argument_fields": [],
  "allow_demo_boolean_approval": false,
  "kill_switches": {
    "backend": "sqlite",
    "cache_ttl_seconds": 1.0
  },
  "blocked_argument_patterns": [
    "(^|/)\\.ssh(/|$)",
    "(^|/)\\.aws(/|$)",
    "(^|/)\\.env$",
    "id_rsa",
    "BEGIN [A-Z ]*PRIVATE KEY",
    "\\bcurl\\b",
    "\\bwget\\b"
  ],
  "forbidden_argument_keys": [
    "access_token",
    "authorization",
    "bearer_token",
    "oauth_token",
    "upstream_token"
  ],
  "allowed_argument_values": {},
  "inbound_content_inspection": {
    "mode": "fail_closed",
    "max_scan_bytes": 262144,
    "max_medium_findings": 3,
    "thresholds": {
      "tool_description": "medium",
      "tool_argument": "medium",
      "tool_result": "high"
    }
  },
  "redacted_key_patterns": [
    "api[_-]?key",
    "authorization",
    "password",
    "secret",
    "token"
  ],
  "redacted_value_patterns": [
    "sk-[A-Za-z0-9_-]{8,}",
    "ghp_[A-Za-z0-9]{8,}",
    "(?<![A-Za-z0-9])(?-i:(?:AKIA|ASIA)[A-Z0-9]{16})(?![A-Za-z0-9])",
    "\\bgithub_pat_[A-Za-z0-9_]{20,}\\b",
    "\\b(?:gho|ghs|ghu|ghr)_[A-Za-z0-9]{20,}\\b",
    "\\bxox[abprs]-[A-Za-z0-9-]{10,}\\b",
    "\\bAIza[A-Za-z0-9_-]{35}\\b",
    "\\b(?:sk_live|rk_live)_[A-Za-z0-9]{16,}\\b",
    "(?i:\\bBearer\\s+)[A-Za-z0-9._~+/=-]{16,}",
    "\\beyJ[A-Za-z0-9_-]*\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\b",
    "\\bhttps?://[^/\\s:@]+:[^@\\s/]+@[^\\s/]+",
    "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?-----END [A-Z ]*PRIVATE KEY-----"
  ],
  "approval_required": [],
  "actor_permissions": {
    "local-operator": [],
    "anonymous": []
  },
  "actor_required_tools": [],
  "production_environments": [
    "prod",
    "production"
  ],
  "rollback_plan_required": [],
  "dry_run_supported": [],
  "shadow_mode_supported": [],
  "rate_limits_per_minute": {
    "default": 30
  },
  "global_rate_limit_per_minute": 300,
  "allowed_tools": {}
}

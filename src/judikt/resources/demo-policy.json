{
  "local_stdio_identity": "sre-oncall",
  "identity_argument_fields": [
    "actor"
  ],
  "allow_demo_boolean_approval": false,
  "blocked_argument_patterns": [
    "(^|/)\\.ssh(/|$)",
    "(^|/)\\.aws(/|$)",
    "(^|/)\\.env$",
    "id_rsa",
    "BEGIN [A-Z ]*PRIVATE KEY",
    "\\bcurl\\b",
    "\\bwget\\b"
  ],
  "forbidden_argument_keys": [
    "access_token",
    "authorization",
    "bearer_token",
    "oauth_token",
    "upstream_token"
  ],
  "allowed_argument_values": {
    "platform.run_diagnostic": {
      "command": [
        "dependency-health",
        "error-rate",
        "latency-summary"
      ]
    },
    "argus.propose_remediation": {
      "action_type": [
        "collect_diagnostics",
        "restart_service",
        "rollback_config",
        "reload_nginx",
        "clear_redis_keyspace",
        "drain_postgres_connections",
        "revert_feature_flag"
      ],
      "risk": [
        "low",
        "medium"
      ],
      "dry_run": [
        true
      ],
      "advisory_only": [
        true
      ]
    }
  },
  "inbound_content_inspection": {
    "mode": "fail_closed",
    "max_scan_bytes": 262144
  },
  "redacted_key_patterns": [
    "api[_-]?key",
    "authorization",
    "password",
    "secret",
    "token"
  ],
  "redacted_value_patterns": [
    "sk-[A-Za-z0-9_-]{8,}",
    "ghp_[A-Za-z0-9]{8,}",
    "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?-----END [A-Z ]*PRIVATE KEY-----"
  ],
  "approval_required": [
    "platform.restart_deployment",
    "platform.rollback_deployment",
    "kubernetes.restart_pod"
  ],
  "actor_permissions": {
    "demo-operator": [
      "platform.*",
      "kubernetes.*",
      "incident.*"
    ],
    "sre-oncall": [
      "platform.*",
      "kubernetes.*",
      "incident.*"
    ],
    "readonly": [
      "platform.health",
      "platform.read_config",
      "platform.read_logs",
      "incident.timeline"
    ],
    "anonymous": [
      "platform.health",
      "platform.read_config",
      "platform.read_logs",
      "platform.run_diagnostic",
      "incident.*",
      "kubernetes.get_pod",
      "kubernetes.rollout_status"
    ],
    "argus-ai-service": [
      "argus.propose_remediation"
    ]
  },
  "actor_required_tools": [
    "argus.propose_remediation",
    "platform.restart_deployment",
    "platform.rollback_deployment",
    "kubernetes.restart_pod"
  ],
  "production_environments": [
    "prod",
    "production"
  ],
  "rollback_plan_required": [
    "platform.restart_deployment",
    "platform.rollback_deployment",
    "kubernetes.restart_pod"
  ],
  "dry_run_supported": [
    "platform.restart_deployment",
    "platform.rollback_deployment",
    "kubernetes.restart_pod"
  ],
  "shadow_mode_supported": [
    "platform.restart_deployment",
    "platform.rollback_deployment",
    "kubernetes.restart_pod"
  ],
  "rate_limits_per_minute": {
    "default": 30,
    "platform.health": 10,
    "platform.rollback_deployment": 3,
    "kubernetes.restart_pod": 3
  },
  "global_rate_limit_per_minute": 300,
  "allowed_tools": {
    "platform-ops": [
      "platform.health",
      "platform.read_config",
      "platform.read_logs",
      "platform.run_diagnostic",
      "platform.restart_deployment",
      "platform.rollback_deployment"
    ],
    "kubernetes": [
      "kubernetes.get_pod",
      "kubernetes.restart_pod",
      "kubernetes.rollout_status"
    ],
    "incident": [
      "incident.create",
      "incident.attach_evidence",
      "incident.timeline"
    ],
    "argus-ai": [
      "argus.propose_remediation"
    ]
  }
}
